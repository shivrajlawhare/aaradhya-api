# MongoDB connection string (Atlas SRV URI or mongodb://localhost:27017)
MONGODB_URI="mongodb://localhost:27017"

# Logical database Mongoose connects to (kept separate from the URI so the
# same cluster URI can be reused across environments)
MONGODB_DB_NAME="aaradhya"

# Port the API listens on
PORT=4000

# Secret for signing session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="change-me"

# Session token lifetime — any `jose` duration string (30m, 8h, 7d, ...)
JWT_EXPIRES_IN="8h"

# DNS servers Node uses to resolve the mongodb+srv:// SRV record (comma-
# separated). Only needed if you hit "querySrv ESERVFAIL" connecting to
# Atlas — Node's resolver doesn't reliably pick up Windows' configured DNS
# servers for SRV lookups. Default is Google/Cloudflare public DNS.
# DNS_SERVERS="8.8.8.8,1.1.1.1"
